# Copy to .env and fill in. Never commit .env.

# Read token for a Hugging Face account that has accepted the Llama 3.2 licence and can read
# the private adapter repo (downloads the base model, adapter and FAQ index at start-up)
HF_TOKEN=

# Key that applications (and the promptfoo suite) send in the x-api-key header to call /v1/inference
APP_KEY=

# Bearer token Prometheus sends when scraping /metrics (put the same value in infrastructure/prometheus/metrics_token)
METRICS_TOKEN=

# Optional settings
# HF_REPO=shyam003/hdfc-faq-assistant     # private repo holding the adapters and FAQ index
# MODEL_VERSION=llama_v2                  # override the registry's live version
# REQUESTS_PER_MINUTE=20                  # gateway rate limit per caller
# SLO_P95_LATENCY_MS=30000                # p95 answer-time target
